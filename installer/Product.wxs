<?xml version="1.0" encoding="UTF-8"?>
<!--
  installer/Product.wxs
  =====================
  WiX v4-compatible installer definition for the Windows Cleaner GUI.

  Supports both WiX v4 (wix build) and WiX v3 (candle + light) with
  minor namespace adjustments – the v4 namespace is used here.

  Variables (passed via -d on the command line or scripts/build_msi.ps1):
    SourceDir  – path to the PyInstaller output folder (dist\WindowsCleaner\)
    Version    – product version string, e.g. 1.0.0

  Build (WiX v4):
    wix build installer\Product.wxs \
        -d SourceDir=dist\WindowsCleaner \
        -d Version=1.0.0 \
        -o dist\WindowsCleaner-1.0.0.msi

  Build (WiX v3):
    candle -dSourceDir=dist\WindowsCleaner -dVersion=1.0.0 installer\Product.wxs
    light  -ext WixUIExtension -o dist\WindowsCleaner-1.0.0.msi Product.wixobj
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
    Name="Windows Cleaner"
    Manufacturer="Chainski"
    Version="$(var.Version)"
    UpgradeCode="4A3F9B2C-1D5E-4F7A-8C0B-2E6D9A1F3B5C"
    Language="1033"
    Codepage="1252"
    InstallerVersion="500"
    Compressed="yes"
    Scope="perMachine">

    <!-- ------------------------------------------------------------------ -->
    <!-- Media / cabinet                                                      -->
    <!-- ------------------------------------------------------------------ -->
    <Media Id="1" Cabinet="WindowsCleaner.cab" EmbedCab="yes" />

    <!-- ------------------------------------------------------------------ -->
    <!-- Upgrade logic (major upgrade: remove old, install new)              -->
    <!-- ------------------------------------------------------------------ -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of Windows Cleaner is already installed." />

    <!-- ------------------------------------------------------------------ -->
    <!-- Directory structure                                                  -->
    <!-- ------------------------------------------------------------------ -->
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="MANUFACTURERDIR" Name="Chainski">
        <Directory Id="INSTALLDIR" Name="Windows Cleaner" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="STARTMENUFOLDER" Name="Windows Cleaner" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- ------------------------------------------------------------------ -->
    <!-- Features                                                             -->
    <!-- ------------------------------------------------------------------ -->
    <Feature Id="ProductFeature" Title="Windows Cleaner" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="RegistryEntries" />
    </Feature>

    <!-- ------------------------------------------------------------------ -->
    <!-- UI                                                                   -->
    <!-- ------------------------------------------------------------------ -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

    <!-- Accept licence without displaying it (add LicenseRtf for full EULA) -->
    <WixVariable Id="WixUILicenseRtf" Value="installer\License.rtf" />

    <!-- ------------------------------------------------------------------ -->
    <!-- Component groups                                                     -->
    <!-- ------------------------------------------------------------------ -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLDIR">
      <!--
        Harvest all files from the PyInstaller output folder.
        In a production build, replace this with explicit <File> elements
        or use the WiX heat tool:
          heat dir dist\WindowsCleaner -cg AppFiles -dr INSTALLDIR -gg -scom -sreg -sfrag -srd -out installer\AppFiles.wxs
      -->
      <Component Id="MainExe" Guid="*">
        <File Id="WindowsCleanerExe"
              Source="$(var.SourceDir)\WindowsCleaner.exe"
              KeyPath="yes" />
      </Component>

      <!-- Recurse remaining files via a directory reference pattern.
           For a real build, enumerate all PyInstaller outputs here or
           use the heat-harvested fragment. -->
    </ComponentGroup>

    <!-- Start Menu shortcut -->
    <Component Id="StartMenuShortcut"
               Directory="STARTMENUFOLDER"
               Guid="B1C2D3E4-F5A6-7890-ABCD-EF1234567890">
      <Shortcut Id="StartMenuExeShortcut"
                Name="Windows Cleaner"
                Target="[INSTALLDIR]WindowsCleaner.exe"
                WorkingDirectory="INSTALLDIR"
                Icon="AppIcon" />
      <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\Chainski\Windows Cleaner"
                     Name="StartMenuShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Optional Desktop shortcut (installed by default; set Level="100" to make optional) -->
    <Component Id="DesktopShortcut"
               Directory="DesktopFolder"
               Guid="C2D3E4F5-A6B7-8901-BCDE-F12345678901">
      <Shortcut Id="DesktopExeShortcut"
                Name="Windows Cleaner"
                Target="[INSTALLDIR]WindowsCleaner.exe"
                WorkingDirectory="INSTALLDIR"
                Icon="AppIcon" />
      <RegistryValue Root="HKCU"
                     Key="Software\Chainski\Windows Cleaner"
                     Name="DesktopShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Registry: Add/Remove Programs metadata -->
    <Component Id="RegistryEntries"
               Directory="INSTALLDIR"
               Guid="D3E4F5A6-B7C8-9012-CDEF-123456789012">
      <RegistryKey Root="HKLM"
                   Key="Software\Chainski\Windows Cleaner">
        <RegistryValue Name="Version" Type="string" Value="$(var.Version)" />
        <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLDIR]" />
      </RegistryKey>
      <RegistryValue Root="HKLM"
                     Key="Software\Chainski\Windows Cleaner"
                     Name="Installed" Type="integer" Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- ------------------------------------------------------------------ -->
    <!-- Icons                                                                -->
    <!-- ------------------------------------------------------------------ -->
    <Icon Id="AppIcon"
          SourceFile="$(var.SourceDir)\windows_cleaner_gui\resources\icons\app.ico" />

    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK"
              Value="https://github.com/jeffmaxey/jeffmaxey" />

  </Package>
</Wix>
